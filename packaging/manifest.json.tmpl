{
  "manifest_version": "0.3",
  "name": "frontmatter-mcp",
  "display_name": "Frontmatter",
  "version": "__VERSION__",
  "description": "Reads only the YAML frontmatter block of markdown files, without loading the document body.",
  "long_description": "frontmatter-mcp streams just the frontmatter block off disk - stopping at the closing '---', never touching the body - and returns structured data, so surveying dozens of documents costs a fraction of the tokens and I/O.",
  "author": {
    "name": "Wannes Gennar",
    "url": "https://github.com/dealloc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dealloc/frontmatter-mcp"
  },
  "homepage": "https://github.com/dealloc/frontmatter-mcp",
  "documentation": "https://github.com/dealloc/frontmatter-mcp#readme",
  "support": "https://github.com/dealloc/frontmatter-mcp/issues",
  "license": "AGPL-3.0-or-later",
  "server": {
    "type": "binary",
    "entry_point": "server/__ENTRY__",
    "mcp_config": {
      "command": "${__dirname}/server/__ENTRY__",
      "args": [],
      "env": {},
      "platform_overrides": {
        "win32": {
          "command": "${__dirname}/server/__ENTRY__.exe"
        }
      }
    }
  },
  "compatibility": {
    "platforms": ["__PLATFORM__"]
  },
  "tools": [
    {
      "name": "read_frontmatter",
      "description": "Reads only the YAML frontmatter of a single markdown file, without loading the document body.",
      "annotations": {
        "title": "Read frontmatter",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "read_frontmatter_batch",
      "description": "Reads only the YAML frontmatter from multiple markdown files, given either explicit paths or a glob pattern.",
      "annotations": {
        "title": "Read frontmatter (batch)",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "get_frontmatter_properties",
      "description": "Extracts specific named properties from the frontmatter of multiple markdown files.",
      "annotations": {
        "title": "Get frontmatter properties",
        "readOnlyHint": true,
        "destructiveHint": false,
        "openWorldHint": false
      }
    }
  ]
}
